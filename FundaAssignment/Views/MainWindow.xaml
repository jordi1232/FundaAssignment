<Window x:Class="FundaAssignment.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FundaAssignment"
        xmlns:vm="clr-namespace:FundaAssignment.ViewModels"
        mc:Ignorable="d"
        Title="Funda assignment" Height="470" Width="800">
    <Window.DataContext>
        <vm:MakelaarAantalViewModel/>
    </Window.DataContext>

    <StackPanel Orientation="Vertical" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal">
            <Button x:Name="btnAmsterdamRequest" IsEnabled="{Binding CanStart}" Height="30" Margin="5" Content="Send request 'Amsterdam'" Click="btnAmsterdamRequest_Click"/>
            <Button x:Name="btnTuinRequest" IsEnabled="{Binding CanStart}" Height="30" Margin="5" Content="Send request 'Tuin'" Click="btnTuinRequest_Click"/>
            <Button x:Name="btnCancel" IsEnabled="{Binding CanCancel}" Height="30" Margin="5" Content="Stop" HorizontalAlignment="Right" Click="btnCancel_Click"/>
        </StackPanel>

        <ListView MaxHeight="251" VerticalAlignment="Stretch" Name="vwMakelaarOccurrences" ItemsSource="{Binding Top10}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Makelaar" Width="600" DisplayMemberBinding="{Binding MakelaarNaam}">
                        <GridViewColumn.HeaderContainerStyle>
                            <Style TargetType="{x:Type GridViewColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                            </Style>
                        </GridViewColumn.HeaderContainerStyle>
                    </GridViewColumn>
                    <GridViewColumn Header="Aantal" Width="195" DisplayMemberBinding="{Binding Aantal}">
                        <GridViewColumn.HeaderContainerStyle>
                            <Style TargetType="{x:Type GridViewColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                            </Style>
                        </GridViewColumn.HeaderContainerStyle>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <Grid Height="16">
            <ProgressBar Minimum="0" Maximum="{Binding MaxItems}" Value="{Binding CompletedEntries, Mode=OneWay}" Name="pbStatus" />
            <TextBlock Text="{Binding LoadText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <TextBox x:Name="txtDebug" Height="173"/>
    </StackPanel>
</Window>
